## ----------------------------------------------------------------------
## .NET / Visual Studio / C# gitignore
## ----------------------------------------------------------------------

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Tt]est[Rr]esults/
[Bb]uild/
publish/

# Visual Studio temporary files, caches, and user settings
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.launchSettings.json.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains Rider / ReSharper
.idea/
_ReSharper*/
*.DotSettings.user

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/

# Application Specific / Local data
App_Data/
*.local.json
appsettings.*.local.json

# Environment / Secret files
.env
.env.*
!.env.example

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Crash dumps and memory traces
*.dmp
*.dump
*.crash
